  LANGUAGE_COMPILE_FLAGS = -O0 -g3 -fno-omit-frame-pointer                      -DOPENMC_DEBUG_FISSION_SOURCE                      -fsanitize=address,undefined                      -fsanitize-address-use-after-scope                      -fno-sanitize-recover=undefined -g
  OBJECT_DIR = vendor/pugixml/CMakeFiles/pugixml.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = vendor/pugixml/CMakeFiles/pugixml.dir/pugixml.pdb
  TARGET_FILE = lib/libpugixml.a
  TARGET_PDB = lib/libpugixml.pdb

