# =============================================================================
# Object build statements for STATIC_LIBRARY target pugixml


#############################################
# Order-only phony target for pugixml

build cmake_object_order_depends_target_pugixml: phony || vendor/pugixml/CMakeFiles/pugixml.dir

build vendor/pugixml/CMakeFiles/pugixml.dir/src/pugixml.cpp.o: CXX_COMPILER__pugixml_unscanned_Debug /home/ciara-byers/Projects/openmc_rb/vendor/pugixml/src/pugixml.cpp || cmake_object_order_depends_target_pugixml
  DEP_FILE = vendor/pugixml/CMakeFiles/pugixml.dir/src/pugixml.cpp.o.d
  FLAGS = -O0 -g3 -fno-omit-frame-pointer                      -DOPENMC_DEBUG_FISSION_SOURCE                      -fsanitize=address,undefined                      -fsanitize-address-use-after-scope                      -fno-sanitize-recover=undefined -g -std=c++14 -fPIC
  INCLUDES = -I/home/ciara-byers/Projects/openmc_rb/vendor/pugixml/src
  OBJECT_DIR = vendor/pugixml/CMakeFiles/pugixml.dir
  OBJECT_FILE_DIR = vendor/pugixml/CMakeFiles/pugixml.dir/src
  TARGET_COMPILE_PDB = vendor/pugixml/CMakeFiles/pugixml.dir/pugixml.pdb
  TARGET_PDB = lib/libpugixml.pdb


